#%Module1.0#####################################################################

set modulefile [lrange [split [module-info name] {/}] 0 0]
set release    [lrange [split [module-info name] {/}] 1 1]
set appname   "emep-mscw"
set appurl    https://github.com/metno/emep-mscw/releases

proc ModulesDisplay {} {
  global appname release

  puts stderr "\nLoads $appname version $release"
}

proc ModulesHelp { } {
  global appname appurl modulefile release

  puts stderr "The $modulefile modulefile defines the default system paths and"
  puts stderr "environment variables needed to compile $appname.\n"
  puts stderr "Documentation on $appurl.\n"
}

module-whatis   "EMEP-MSC/W chemical transport model"

switch $::env(HOSTNAME) {
  nebula.nsc.liu.se   {setenv  MACHINE  nebula  }
  nebula2.nsc.liu.se  {setenv  MACHINE  nebula2 }
  stratus.nsc.liu.se  {setenv  MACHINE  stratus }
  stratus2.nsc.liu.se {setenv  MACHINE  stratus2}
}

switch $::env(HOSTNAME) {
  nebula.nsc.liu.se  - stratus.nsc.liu.se  {
    module  load     buildenv-intel/2018a-eb FFTW/3.3.6-nsc1
    prereq           buildenv-intel/2018a-eb FFTW/3.3.6-nsc1
    module  load     netCDF-HDF5/4.3.2-1.8.12-nsc1-intel-2018.u1-bare
    prereq           netCDF-HDF5/4.3.2-1.8.12-nsc1-intel-2018.u1-bare
    module  load     Python/3.6.7-env-nsc1-gcc-2018a-eb
    prereq           Python/3.6.7-env-nsc1-gcc-2018a-eb
  }
  nebula2.nsc.liu.se - stratus2.nsc.liu.se {
   #module  load     makedepf90/2.8.8-hpc1-gcc-2022a-eb
   #prereq           makedepf90/2.8.8-hpc1-gcc-2022a-eb
    module  load     buildenv-intel/2023a-eb FFTW/3.3.9
    prereq           buildenv-intel/2023a-eb FFTW/3.3.9
    module  load     netCDF-HDF5/4.9.2-1.12.2-hpc1
    prereq           netCDF-HDF5/4.9.2-1.12.2-hpc1
    module  load     Python/3.10.4-env-hpc1-gcc-2022a-eb
    prereq           Python/3.10.4-env-hpc1-gcc-2022a-eb
  }
}
